# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Your Polygon.io API key (get from https://polygon.io)
POLYGON_API_KEY=your_polygon_api_key_here

# A secret key to protect the manual scan endpoint
# Make this a long random string, e.g. openssl rand -hex 32
SCAN_API_KEY=your_secret_scan_key_here

# Comma-separated list of allowed frontend origins
# In production, set this to your exact Vercel URL, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
